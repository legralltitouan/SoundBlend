# Configuration SoundBlend AI
# ID client OAuth 2.0 Google Cloud (pour YouTube Data API v3)
VITE_GOOGLE_CLIENT_ID=….apps.googleusercontent.com

# Clé API Google Cloud (restreinte HTTP referrer localhost:5173, localhost:4173)
VITE_YOUTUBE_API_KEY=

# Clé d'API Google Gemini (depuis https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=

# Modèle Gemini par défaut (ex: gemini-2.5-flash, gemini-3.5-flash-lite, gemini-2.0-flash)
VITE_GEMINI_MODEL=gemini-2.5-flash
